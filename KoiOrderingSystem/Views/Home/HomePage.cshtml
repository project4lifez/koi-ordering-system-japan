<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Imperial Koi | Premium Japanese Koi Farm</title>
    <link rel="stylesheet" href="~/css/HomePage.css" />
    <style>
        .header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            z-index: 1000 !important;
            transition: var(--transition-normal) !important;
            background: none !important;
            backdrop-filter: none !important;
        }

            .header.scrolled {
                background: rgba(15, 23, 42, 0.9) !important;
                backdrop-filter: blur(10px) !important;
            }

        .feedback-author-info {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .feedback-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }

        .feedback-author {
            font-size: 1.1em;
            font-weight: bold;
            margin: 0;
        }

        .feedback-text {
            font-size: 1.1rem;
            color: var(--gray-800);
            margin-top: 10px;
            font-style: italic!important; /* Chữ in nghiêng cho phần comment */
            position: relative;
            padding: 10px;
            font-family: 'Georgia', serif; /* Font chữ đẹp hơn cho nội dung feedback */
        }

            .feedback-text::before, .feedback-text::after {
                content: '"';
                font-size: 1.5rem;
                color: var(--gray-500); /* Màu sắc nhẹ cho dấu ngoặc kép */
                vertical-align: top;
            }

            .feedback-text::before {
                margin-right: 5px;
            }

            .feedback-text::after {
                margin-left: 5px;
            }

    </style>
</head>

<body>
    <!-- Loading Screen -->
    <div class="loader-wrapper" id="loader">
        <div class="loader"></div>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <video class="hero-video" autoplay muted loop>
            <source src="/images/KoiFishIn8K.mp4" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div>
                <h1 class="hero-title">Experience the Art of Koi</h1>
                <p class="hero-subtitle">Discover world-class Japanese Koi in our premium breeding facility</p>
                <div class="hero-buttons">
                    <a href="#booking" class="btn btn-primary" style="background-color:#5BB2F1!important;">
                        Booking Now <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="#varieties" class="btn btn-outline">
                        Explore Varieties <i class="fas fa-fish"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <p>Scroll to explore</p>
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="about">
        <div class="about-grid">
            <div class="about-content" data-aos="fade-right">
                <p class="section-subtitle">Our Heritage</p>
                <h2 class="section-title">Premium Japanese Koi Breeding</h2>
                <p class="about-text">
                    With over two decades of experience in Koi breeding, we maintain the highest standards of Japanese
                    tradition while embracing modern technology. Our facility specializes in raising award-winning Koi
                    varieties, ensuring each fish reaches its full potential.
                </p>
                <div class="about-features">
                    <div class="feature-card">
                        <i class="fas fa-award feature-icon"></i>
                        <h3 class="feature-title">Premium Quality</h3>
                        <p class="feature-text">Champion bloodlines from Japan's top breeders</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-water feature-icon"></i>
                        <h3 class="feature-title">Advanced Facility</h3>
                        <p class="feature-text">State-of-the-art water management systems</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-certificate feature-icon"></i>
                        <h3 class="feature-title">Certified</h3>
                        <p class="feature-text">International breeding certifications</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-shipping-fast feature-icon"></i>
                        <h3 class="feature-title">Global Shipping</h3>
                        <p class="feature-text">Worldwide delivery with care</p>
                    </div>
                </div>
            </div>
            <div class="about-image" data-aos="fade-left">
                <img src="/api/placeholder/600/800" alt="Premium Koi Facility">
            </div>
        </div>
    </section>

   <!-- Our Partner Farm Section -->
<section id="partner-farms" class="partner-farms">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <p class="section-subtitle">Our Partners</p>
            <h2 class="section-title">Partner Farms</h2>
        </div>

        <div class="farm-gallery" data-aos="fade-up">
                @foreach (var farm in ViewBag.KoiFarms)
                {
                    <div class="farm-card">
                        <img src="@farm.ImageUrl" alt="@farm.FarmName">
                        <div class="farm-content">
                            <h3 class="farm-name">@farm.FarmName</h3>
                            <p class="farm-description">@farm.ContactInfo</p>
                        </div>
                    </div>
                }
            <!-- Additional farms can be added here -->
        </div>
    </div>
</section>

    <!-- Koi Varieties Section -->
    <section id="varieties" class="varieties">
        <div class="varieties-container">
            <div class="text-center" data-aos="fade-up">
                <p class="section-subtitle">Our Collection</p>
                <h2 class="section-title">Premium Koi Varieties</h2>
            </div>
            
            <div class="filter-buttons" data-aos="fade-up">
                <button class="filter-btn active" data-filter="all">All Varieties</button>
                <button class="filter-btn" data-filter="kohaku">Kohaku</button>
                <button class="filter-btn" data-filter="sanke">Sanke</button>
                <button class="filter-btn" data-filter="showa">Showa</button>
                <button class="filter-btn" data-filter="metallic">Metallic</button>
                <button class="filter-btn" data-filter="premium">Premium Selection</button>
            </div>

            <div class="varieties-grid">
                <!-- Kohaku -->
                <div class="variety-card" data-category="kohaku" data-aos="fade-up">
                    <img src="https://koilover.vn/uploads/images/nguon-goc-kohaku.jpg" alt="Kohaku Koi" class="variety-image">
                    <div class="variety-content">
                        <div class="variety-title">
                            <span>Kohaku</span>
                            <span class="variety-japanese">紅白</span>
                        </div>
                        <div class="variety-details">
                            <div class="variety-detail">
                                <i class="fas fa-ruler"></i>
                                <span>Size: 65-75 cm</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-calendar"></i>
                                <span>Age: 3-4 years</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-trophy"></i>
                                <span>Award Winning Bloodline</span>
                            </div>
                        </div>
                        <div class="variety-price">Starting from $2,500</div>
                        <button class="btn btn-primary">View Details</button>
                    </div>
                </div>
                <div class="variety-card" data-category="kohaku" data-aos="fade-up">
                    <img src="https://koilover.vn/uploads/images/nguon-goc-kohaku.jpg" alt="Kohaku Koi" class="variety-image">
                    <div class="variety-content">
                        <div class="variety-title">
                            <span>Kohaku</span>
                            <span class="variety-japanese">紅白</span>
                        </div>
                        <div class="variety-details">
                            <div class="variety-detail">
                                <i class="fas fa-ruler"></i>
                                <span>Size: 65-75 cm</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-calendar"></i>
                                <span>Age: 3-4 years</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-trophy"></i>
                                <span>Award Winning Bloodline</span>
                            </div>
                        </div>
                        <div class="variety-price">Starting from $2,500</div>
                        <button class="btn btn-primary">View Details</button>
                    </div>
                </div>
                <div class="variety-card" data-category="kohaku" data-aos="fade-up">
                    <img src="https://koilover.vn/uploads/images/nguon-goc-kohaku.jpg" alt="Kohaku Koi" class="variety-image">
                    <div class="variety-content">
                        <div class="variety-title">
                            <span>Kohaku</span>
                            <span class="variety-japanese">紅白</span>
                        </div>
                        <div class="variety-details">
                            <div class="variety-detail">
                                <i class="fas fa-ruler"></i>
                                <span>Size: 65-75 cm</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-calendar"></i>
                                <span>Age: 3-4 years</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-trophy"></i>
                                <span>Award Winning Bloodline</span>
                            </div>
                        </div>
                        <div class="variety-price">Starting from $2,500</div>
                        <button class="btn btn-primary">View Details</button>
                    </div>
                </div>

                <!-- Sanke -->
                <div class="variety-card" data-category="sanke" data-aos="fade-up" data-aos-delay="100">
                    <img src="https://www.cakoi.vn/wp-content/uploads/2018/03/taisho-sanke.jpg" alt="Sanke Koi" class="variety-image">
                    <div class="variety-content">
                        <div class="variety-title">
                            <span>Taisho Sanke</span>
                            <span class="variety-japanese">大正三色</span>
                        </div>
                        <div class="variety-details">
                            <div class="variety-detail">
                                <i class="fas fa-ruler"></i>
                                <span>Size: 60-70 cm</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-calendar"></i>
                                <span>Age: 3 years</span>
                            </div>
                            <div class="variety-detail">
                                <i class="fas fa-trophy"></i>
                                <span>Show Quality</span>
                            </div>
                        </div>
                        <div class="variety-price">Starting from $3,000</div>
                        <button class="btn btn-primary">View Details</button>
                    </div>
                </div>
                <!-- Additional Koi varieties can be added here -->
            </div>
        </div>
    </section>

    <!-- Booking Steps Section -->
<section id="booking" class="booking">
    <div class="booking-container">
        <div class="booking-content" data-aos="fade-right">
            <p class="section-subtitle">Booking Process</p>
            <h2 class="section-title">How to Book Your Koi</h2>
            <div class="booking-steps">
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <h3 class="step-title">1. Submit Your Request</h3>
                    <p class="step-description">Select the Koi fish breed you're interested in and send your request to us.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <h3 class="step-title">2. Farm Selection Consultation</h3>
                    <p class="step-description">Our sales staff will recommend suitable farms based on your preferences.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-map-signs"></i>
                    </div>
                    <h3 class="step-title">3. Itinerary Planning</h3>
                    <p class="step-description">Choose your preferred farm, and we will create a detailed trip itinerary.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <h3 class="step-title">4. Quotation Approval</h3>
                    <p class="step-description">We send a quotation for your approval and payment.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="step-title">5. Confirm Trip Details</h3>
                    <p class="step-description">Receive the detailed itinerary and support information for your visit.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-fish"></i>
                    </div>
                    <h3 class="step-title">6. Farm Visit and Fish Purchase</h3>
                    <p class="step-description">Our staff will assist you in selecting and negotiating the price for the Koi fish.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h3 class="step-title">7. Payment and Delivery</h3>
                    <p class="step-description">After selecting your fish, we will arrange delivery to your hotel or specified address.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h3 class="step-title">8. Payment and Delivery</h3>
                    <p class="step-description">After selecting your fish, we will arrange delivery to your hotel or specified address.</p>
                </div>
            </div>
        </div>
    </div>
</section>

    <!-- Customer Feedback Section -->
    <section id="feedback" class="feedback">
        <div class="feedback-container">
            <h2 class="section-title">What Our Customers Say</h2>
            <div class="feedback-grid">
                @foreach (var feedback in ViewBag.Feedbacks)
                {
                    <div class="feedback-card" data-aos="fade-up">
                        <!-- Avatar -->
                        <img src="@feedback.Customer.Account.ImageUrl" alt="Avatar of @feedback.Customer.Account.Firstname" class="feedback-avatar">

                        <!-- Name -->
                        <h4 class="feedback-author">
                            @feedback.Customer.Account.Firstname @feedback.Customer.Account.Lastname
                        </h4>

                        <!-- Star Rating -->
                        <div class="feedback-rating">
                            @{
                                for (int i = 0; i < feedback.Rating; i++)
                                {
                                    <i class="fas fa-star" style="color: #FFD700;"></i>
                                }
                                for (int i = feedback.Rating; i < 5; i++)
                                {
                                    <i class="far fa-star" style="color: #FFD700;"></i>
                                }
                            }
                        </div>

                        <!-- Feedback Text -->
                        <p class="feedback-text">@feedback.Comments</p>
                    </div>
                }
            </div>
        </div>
    </section>



    <!-- Contact Section -->
<section id="contact" class="contact">
    <div class="contact-container">
        <div class="contact-info" data-aos="fade-right">
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="contact-text">
                    <h3>Location</h3>
                    <p>Lot E2a-7, Road D1, D1 Street, Long Thanh My, Thu Duc City, Ho Chi Minh City 700000</p>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <div class="contact-text">
                    <h3>Phone</h3>
                    <p>+84 24.32.666.777</p>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div class="contact-text">
                    <h3>Email</h3>
                    <p>info@imperialkoi.com</p>
                </div>
            </div>
        </div>

        <!-- Google Map Embed -->
        <div class="google-map" data-aos="fade-left">
            <h3>Visit Us</h3>
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.6100105370224!2d106.8073080748058!3d10.84112758931163!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752731176b07b1%3A0xb752b24b379bae5e!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBGUFQgVFAuIEhDTQ!5e0!3m2!1svi!2s!4v1730219285925!5m2!1svi!2s" 
                width="600" 
                height="450" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy">
            </iframe>
        </div>
    </div>
</section>

 
    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>   

        // Khởi tạo hiệu ứng AOS
        AOS.init({ duration: 800, once: true });

        // Loading Screen
        window.addEventListener('load', () => {
            document.getElementById('loader').style.display = 'none';
        });

       
        // Header Scroll Effect
        const header = document.querySelector('.header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });


        // Variety Filter
        const filterBtns = document.querySelectorAll('.filter-btn');
        const varietyCards = document.querySelectorAll('.variety-card');
        if (filterBtns.length && varietyCards.length) {
            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const filterValue = btn.getAttribute('data-filter');
                    varietyCards.forEach(card => {
                        card.style.display = (filterValue === 'all' || card.getAttribute('data-category') === filterValue) ? 'block' : 'none';
                    });
                });
            });
        }

      

     
   </script>
</body>
</html>

