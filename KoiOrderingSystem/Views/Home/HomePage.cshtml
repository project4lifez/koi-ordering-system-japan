@model List<KoiOrderingSystem.Models.KoiFish>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Koi88 | Premium Japanese Koi Ordering</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/HomePage.css" />
    <style>
        .header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            z-index: 1000 !important;
            transition: var(--transition-normal) !important;
            background: none !important;
            backdrop-filter: none !important;
        }

            .header.scrolled {
                background: rgba(15, 23, 42, 0.9) !important;
                backdrop-filter: blur(10px) !important;
            }

        .feedback-author-info {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .feedback-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }

        .feedback-author {
            font-size: 1.1em;
            font-weight: bold;
            margin: 0;
        }

        .feedback-text {
            font-size: 1.1rem;
            color: var(--gray-800);
            margin-top: 10px;
            font-style: italic!important; /* Chữ in nghiêng cho phần comment */
            position: relative;
            padding: 10px;
            font-family: 'Georgia', serif; /* Font chữ đẹp hơn cho nội dung feedback */
        }

            .feedback-text::before, .feedback-text::after {
                content: '"';
                font-size: 1.5rem;
                color: var(--gray-500); /* Màu sắc nhẹ cho dấu ngoặc kép */
                vertical-align: top;
            }

            .feedback-text::before {
                margin-right: 5px;
            }

            .feedback-text::after {
                margin-left: 5px;
            }

        .navigation-menu {
            margin-top: 16px !important;
        }

        .farm-card img {
            width: 100%;
            height: 225px;
            object-fit: cover;
            object-position: center;
            transition: transform 0.3s ease;
            background-size: cover;
            background-position: center;
        }

        .farm-description {
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2; /* Show only two lines */
            -webkit-box-orient: vertical;
        }

        .detail-button {
            background-color: #E9F3FD; /* Soft gray to blend with the theme */
            color: #5BB2F1; /* Dark text for a subtle look */
            padding: 5px 10px;
            border-radius: 5px; /* Rounded corners for a professional look */
            cursor: pointer;
            margin-top: 5px;    
            font-size: 0.9em;
            transition: background-color 0.3s, border-color 0.3s;
            border: none;   
        }

            .detail-button:hover {
                background-color: #d1e8ff; /* Slightly darker shade on hover */
                box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1); /* Light shadow effect */
            }

        .view-more-link {
            font-size: 1.1em;
            color: #5BB2F1;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            transition: color 0.3s;
        }

            .view-more-link i {
                margin-left: 5px;
                transition: transform 0.3s;
            }

            .view-more-link:hover {
                color: #007BFF; /* Change color on hover */
            }

                .view-more-link:hover i {
                    transform: translateX(5px); /* Move the arrow to the right on hover */
                }

        .nav-container {
            margin: -10px auto !important;
        }

        .navigation-menu {
            margin-top: 16px !important;
        }

        .styled-button {
            background-color: transparent;
            color: #007BFF; /* Blue color */
            border: 1px solid #007BFF;
            border-radius: 5px;
            padding: 10px 20px;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

            .styled-button i {
                margin-left: 5px; /* Spacing between text and icon */
                transition: transform 0.3s;
            }

            .styled-button:hover {
                background-color: #E0F0FF; /* Light blue background on hover */
                color: #0056b3; /* Darker blue text on hover */
            }

                .styled-button:hover i {
                    transform: translateY(2px); /* Slight bounce effect on hover */
                }

        .variety-english {
            max-width: 75%;
            height: 70px;
            color: #c40606;
        }

        .about-image {
            position: relative; /* Đảm bảo phần tử giữ vị trí cho transform */
        }

            .about-image img {
                transition: transform 0.3s ease, box-shadow 0.3s ease; /* Thêm hiệu ứng chuyển đổi khi chuột rời đi */
            }

            .about-image:hover img {
                transform: translateY(-5px); /* Di chuyển ảnh lên trên khi hover */
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1); /* Shadow đậm hơn */
                transition: transform 0.3s ease, box-shadow 0.3s ease; /* Áp dụng hiệu ứng mượt mà khi hover */
            }

        .step{
            transition: var(--transition-normal);
        }

        .step:hover {
            transform: translateY(-5px); /* Tăng khoảng cách di chuyển */
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1); /* Đậm hơn và lan rộng hơn */
        }
        
        .variety-card{
            transition: var(--transition-normal);
        }
        .variety-card:hover {
            transform: translateY(-5px)!important; /* Di chuyển lên trên */
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1); /* Thêm bóng đổ */
            }
        
        .feedback-card{
            transition: var(--transition-normal);
        }
        .feedback-card:hover {
            transform: translateY(-5px)!important; /* Di chuyển lên trên */
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1); /* Thêm bóng đổ */
            }

    </style>
</head>

<body>
    <!-- Loading Screen -->
    <div class="loader-wrapper" id="loader">
        <div class="loader"></div>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <video class="hero-video" autoplay muted loop>
            <source src="/images/KoiFishIn8K.mp4" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div>
                <h1 class="hero-title">Experience the Art of Koi</h1>
                <p class="hero-subtitle">Discover world-class Japanese Koi in our premium breeding facility</p>
                <div class="hero-buttons">
                    <a href="Home/BookingForm" class="btn btn-primary" style="background-color:#5BB2F1!important;">
                        Booking Now <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="#varieties" class="btn btn-outline">
                        Explore Varieties <i class="fas fa-fish"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <p>Scroll to explore</p>
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="about">
        <div class="about-grid">
            <div class="about-content" data-aos="fade-right">
                <p class="section-subtitle">Our Journey Together</p>
                <h2 class="section-title">Comprehensive Koi Ordering Service</h2>
                <p class="about-text">
                    Our Koi Ordering System is designed to offer a seamless and personalized experience, from choosing the
                    perfect Koi to ensuring a safe and reliable delivery to your doorstep. With a team dedicated to guiding
                    you through each step, we make Koi ownership easier and more enjoyable.
                </p>
                <div class="about-features">

                    <div class="feature-card">
                        <i class="fas fa-file-invoice feature-icon"></i>
                        <h3 class="feature-title">Detailed Quotations</h3>
                        <p class="feature-text">Transparent pricing and management-approved quotations</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-plane-departure feature-icon"></i>
                        <h3 class="feature-title">On-site Assistance</h3>
                        <p class="feature-text">Guided check-in and dedicated support during your Koi journey</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-fish feature-icon"></i>
                        <h3 class="feature-title">Exclusive Japanese Koi Selection</h3>
                        <p class="feature-text">Sourcing premium Koi from Japan's top breeders</p>
                    </div>
                    <div class="feature-card">
                        <i class="fas fa-truck feature-icon"></i>
                        <h3 class="feature-title">Safe Delivery</h3>
                        <p class="feature-text">Careful delivery of your Koi to your location</p>
                    </div>
                </div>
            </div>
            <div class="about-image" data-aos="fade-left">
                <img src="https://images.unsplash.com/photo-1641374446184-45be9cce898c?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" style="
                     max-height: 710px;
                     width: 600px;
                     margin-top: 60px;
                     border-radius:20px;" alt="Professional Koi Ordering Service">
            </div>
        </div>
    </section>

   <!-- Our Partner Farm Section -->
    <section id="partner-farms" class="partner-farms">
        <div class="container">
            <div class="text-center" data-aos="fade-up">
                <p class="section-subtitle">Our Partners</p>
                <h2 class="section-title">Partner Farms</h2>
            </div>

            <div class="farm-gallery" data-aos="fade-up">
                @foreach (var farm in ViewBag.KoiFarms)
                {
                    <div class="farm-card">
                        <img src="@farm.ImageUrl" alt="@farm.FarmName">
                        <div class="farm-content">
                            <h3 class="farm-name">@farm.FarmName</h3>
                            <p class="farm-description" data-full-text="@farm.ContactInfo">
                            </p>
                            <button class="detail-button" onclick="showFullText(this)">
                                Detail <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4" data-aos="fade-up">
                <a href="/Farm/Farm" class="view-more-link">
                    View More <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </section>


    <!-- Koi Varieties Section -->
    <section id="varieties" class="varieties">
        <div class="varieties-container">
            <div class="text-center" data-aos="fade-up">
                <p class="section-subtitle">Our Collection</p>
                <h2 class="section-title">Premium Koi Varieties</h2>
            </div>

            <div class="filter-buttons" data-aos="fade-up">
                <button class="filter-btn active" data-filter="all">All Varieties</button>
                @foreach (var variety in ViewBag.KoiVarieties)
                {
                    <button class="filter-btn" data-filter="@variety.VarietyName">@variety.VarietyName</button>
                }
            </div>

            <div class="varieties-grid" id="koiGrid">
                @for (int i = 0; i < ViewBag.KoiFishes.Count; i++)
                {
                    var koi = ViewBag.KoiFishes[i];
                    <div class="variety-card" data-category="@koi.Variety.VarietyName" data-aos="fade-up" style="display: @(i < 4 ? "block" : "none")">
                        <img src="@koi.ImageUrl" alt="@koi.KoiName" class="variety-image">
                        <div class="variety-content">
                            <div class="variety-title">
                                <span class="variety-english">@koi.KoiName</span>
                                <span class="variety-japanese">@koi.Koinamejp</span>
                            </div>
                            
                             
                            <div class="variety-details">
                                <div class="variety-detail">
                                    <i class="fas fa-ruler"></i>
                                    <span>Size: @koi.Size</span>
                                </div>
                                <div class="variety-detail">
                                    <i class="fas fa-calendar"></i>
                                    <span>Age: @koi.Age</span>
                                </div>
                                <div class="variety-detail">
                                    <i class="fas fa-trophy"></i>
                                    <span>Variety: @koi.Variety.VarietyName</span>
                                </div>
                            </div>
                            <div class="variety-price">Starting from: @koi.Price?.Substring(0, Math.Min(6, koi.Price.Length))</div>
                            <a href="/Variety/VarietyDetail?id=@koi.Variety.VarietyId" class="btn btn-primary">View Details</a>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <button id="showMoreBtn" class="styled-button" onclick="showMore()">
                    Show More <i class="fas fa-chevron-down"></i>
                </button>
                <button id="showLessBtn" class="styled-button" onclick="showLess()" style="display: none;">
                    Show Less <i class="fas fa-chevron-up"></i>
                </button>
            </div>

        </div>
    </section>


    <!-- Booking Steps Section -->
<section id="booking" class="booking">
    <div class="booking-container">
        <div class="booking-content" data-aos="fade-right">
            <p class="section-subtitle">Booking Process</p>
            <h2 class="section-title">How to Book Your Koi</h2>
            <div class="booking-steps">
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <h3 class="step-title">1. Submit Your Request</h3>
                    <p class="step-description">Select the Koi fish breed you're interested in and send your request to us.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <h3 class="step-title">2. Farm Selection Consultation</h3>
                    <p class="step-description">Our sales staff will recommend suitable farms based on your preferences.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-map-signs"></i>
                    </div>
                    <h3 class="step-title">3. Itinerary Planning</h3>
                    <p class="step-description">Choose your preferred farm, and we will create a detailed trip itinerary.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <h3 class="step-title">4. Quotation Approval</h3>
                    <p class="step-description">We send a quotation for your approval and payment.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="step-title">5. Confirm Trip Details</h3>
                    <p class="step-description">Receive the detailed itinerary and support information for your visit.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-fish"></i>
                    </div>
                    <h3 class="step-title">6. Farm Visit and Fish Purchase</h3>
                    <p class="step-description">Our staff will assist you in selecting and negotiating the price for the Koi fish.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h3 class="step-title">7. Payment and Delivery</h3>
                    <p class="step-description">After selecting your fish, we will arrange delivery to your hotel or specified address.</p>
                </div>
                <div class="step">
                    <div class="step-icon">
                            <i class="fas fa-comment-dots"></i>
                        </div>
                        <h3 class="step-title">8. Feedback</h3>
                        <p class="step-description">Share your experience with us! Your feedback helps us improve our service.</p>
                </div>
            </div>
        </div>
    </div>
</section>

    <!-- Customer Feedback Section -->
    <section id="feedback" class="feedback">
        <div class="feedback-container">
            <h2 class="section-title">What Our Customers Say</h2>
            <div class="feedback-grid">
                @foreach (var feedback in ViewBag.Feedbacks)
                {
                    <div class="feedback-card" data-aos="fade-up">
                        <!-- Avatar -->
                        <img src="@feedback.Customer.Account.ImageUrl" alt="Avatar of @feedback.Customer.Account.Firstname" class="feedback-avatar">

                        <!-- Name -->
                        <h4 class="feedback-author">
                            @feedback.Customer.Account.Firstname @feedback.Customer.Account.Lastname
                        </h4>

                        <!-- Star Rating -->
                        <div class="feedback-rating">
                            @{
                                for (int i = 0; i < feedback.Rating; i++)
                                {
                                    <i class="fas fa-star" style="color: #FFD700;"></i>
                                }
                                for (int i = feedback.Rating; i < 5; i++)
                                {
                                    <i class="far fa-star" style="color: #FFD700;"></i>
                                }
                            }
                        </div>

                        <!-- Feedback Text -->
                        <p class="feedback-text">@feedback.Comments</p>
                    </div>
                }
            </div>
        </div>
    </section>



    <!-- Contact Section -->
<section id="contact" class="contact">
    <div class="contact-container">
        <div class="contact-info" data-aos="fade-right">
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="contact-text">
                    <h3>Location</h3>
                    <p>Lot E2a-7, Road D1, D1 Street, Long Thanh My, Thu Duc City, Ho Chi Minh City 700000</p>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <div class="contact-text">
                    <h3>Phone</h3>
                    <p>+84 24.32.666.777</p>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div class="contact-text">
                    <h3>Email</h3>
                    <p>info@imperialkoi.com</p>
                </div>
            </div>
        </div>

        <!-- Google Map Embed -->
        <div class="google-map" data-aos="fade-left">
            <h3>Visit Us</h3>
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.6100105370224!2d106.8073080748058!3d10.84112758931163!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752731176b07b1%3A0xb752b24b379bae5e!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBGUFQgVFAuIEhDTQ!5e0!3m2!1svi!2s!4v1730219285925!5m2!1svi!2s" 
                width="600" 
                height="450" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy">
            </iframe>
        </div>
    </div>
</section>

 
    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>


        // Khởi tạo hiệu ứng AOS
        AOS.init({ duration: 800, once: true });

        // Loading Screen
        window.addEventListener('load', () => {
            document.getElementById('loader').style.display = 'none';
        });
       
        
       

       
        // Header Scroll Effect
        const header = document.querySelector('.header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });


        // Variety Filter
        const filterBtns = document.querySelectorAll('.filter-btn');
        const varietyCards = document.querySelectorAll('.variety-card');
        if (filterBtns.length && varietyCards.length) {
            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const filterValue = btn.getAttribute('data-filter');
                    varietyCards.forEach(card => {
                        card.style.display = (filterValue === 'all' || card.getAttribute('data-category') === filterValue) ? 'block' : 'none';
                    });
                });
            });
        }

        // Function to truncate text to two lines
        function truncateText() {
            const descriptions = document.querySelectorAll('.farm-description');
            descriptions.forEach(description => {
                const fullText = description.getAttribute('data-full-text');
                description.innerText = truncateToTwoLines(fullText);
            });
        }

        // Helper function to truncate text to two lines (adjust line length as needed)
        function truncateToTwoLines(text) {
            const maxLength = 100; // Adjust based on character count per line for your design
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        // Function to show the full text when "Detail" is clicked
        function showFullText(button) {
            const description = button.previousElementSibling; // Get the description element
            const fullText = description.getAttribute('data-full-text'); // Get the full text
            description.innerText = fullText; // Display the full text

            // Retrieve the FarmId from the button's data attribute
            const farmId = button.getAttribute('data-farm-id');

            // Redirect to the FarmDetail page
            window.location.href = `/Farm/FarmDetail?id=${FarmId}`;

            button.style.display = 'none'; // Hide the "Detail" button after expanding
        }

        // Initialize text truncation on page load
        window.onload = truncateText;

        let visibleCount = 4;
        const koiCards = document.querySelectorAll('.variety-card');
        const showMoreBtn = document.getElementById('showMoreBtn');
        const showLessBtn = document.getElementById('showLessBtn');

        function showMore() {
            let newlyVisibleCount = 0;
            koiCards.forEach((card, index) => {
                if (index >= visibleCount && newlyVisibleCount < 4) {
                    card.style.display = 'block';
                    newlyVisibleCount++;
                }
            });
            visibleCount += newlyVisibleCount;

            // Show "Show Less" button if more koi are displayed
            if (visibleCount > 4) {
                showLessBtn.style.display = 'inline-block';
            }

            // Hide "Show More" button if no more koi to show
            if (visibleCount >= koiCards.length) {
                showMoreBtn.style.display = 'none';
            }
        }

        function showLess() {
            visibleCount = 4; // Reset to the initial visible count
            koiCards.forEach((card, index) => {
                card.style.display = index < visibleCount ? 'block' : 'none';
            });

            // Show "Show More" button again and hide "Show Less"
            showMoreBtn.style.display = 'inline-block';
            showLessBtn.style.display = 'none';

            // Scroll back to the top of the Koi Varieties section
            document.getElementById('varieties').scrollIntoView({ behavior: 'smooth' });
        }

    </script>

     
   
</body>
</html>

