@model KoiOrderingSystem.Models.BlogViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Blog.Heading - Imperial Koi</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bl-primary: #2c3e50;
            --bl-secondary: #e74c3c;
            --bl-text-dark: #2d3436;
            --bl-text-muted: #7f8c8d;
            --bl-bg-light: #f5f6fa;
            --bl-white: #ffffff;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: var(--bl-bg-light);
            color: var(--bl-text-dark);
            line-height: 1.6;
            margin-top: 90px;
        }

        .bl-wrapper {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background-color: var(--bl-white);
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .bl-header {
            text-align: center;
            margin-bottom: 20px;
        }

            .bl-header h1 {
                font-size: 2.2rem;
                color: var(--bl-primary);
                font-weight: 700;
            }

        .bl-meta {
            color: var(--bl-text-muted);
            font-size: 0.9rem;
            margin-top: 10px;
        }

        .bl-content img {
            width: 100%;
            height: auto;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .bl-content h2 {
            font-size: 1.8rem;
            color: var(--bl-primary);
            margin-top: 15px;
            font-weight: 700;
        }

        .bl-content .article-content {
            margin-top: 15px;
            font-size: 1rem;
            line-height: 1.8;
            color: var(--bl-text-dark);
        }
    </style>
</head>
<body>
    <div class="bl-wrapper">
        <div class="bl-header">
            <h1>@Model.Blog.Heading</h1>
            <div class="bl-meta">
                <span>🕒 Published on: @Model.Blog.CreateAt?.ToString("MMM d, yyyy")</span>
                <span>👤 Author: Koi Fish Expert</span>
            </div>
        </div>

        <div class="bl-content">
            <img src="@Model.Blog.Image" alt="@Model.Blog.Heading" class="img-fluid" />
            <h2>Content</h2>
            <div class="article-content">
                @Html.Raw(Model.Blog.Link)
            </div>
        </div>
    </div>
</body>
</html>
