    <title>Imperial Koi | Blog</title>
    <style>
        /* Root Colors */
        :root {
            --primary: #b91c1c;
            --secondary: #1e293b;
            --white: #ffffff;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-900: #0f172a;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--gray-100);
            color: var(--gray-900);
            line-height: 1.6;
            margin: 0;
        }

        a {
            color: var(--primary);
            text-decoration: none;
        }

        /* Container */
        .container {
            display: flex;
            max-width: 1200px;
            margin: 2rem auto;
            gap: 2rem;
        }

        /* Main Featured Blog */
        .main-featured {
            flex: 2;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            background-color: var(--gray-200);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .main-featured:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .main-featured img {
            width: 100%;
            height: auto;
            border-radius: 10px;
            cursor: pointer;
        }

        .main-featured .overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.5);
            padding: 1rem;
            color: var(--white);
            text-align: left;
        }

        .main-featured .overlay h3 {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        .main-featured .overlay p {
            font-size: 1rem;
            margin: 0;
        }

        .main-featured .overlay .meta {
            margin-top: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        /* Side Blogs */
        .side-blogs {
            flex: 1;
            display: grid;
            gap: 1rem;
        }

        .side-blog {
            display: flex;
            gap: 1rem;
            background-color: var(--white);
            padding: 1rem;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .side-blog:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .side-blog img {
            width: 100px;
            height: auto;
            border-radius: 10px;
            object-fit: cover;
        }

        .side-blog-content {
            flex: 1;
        }

        .side-blog h4 {
            font-size: 1.2rem;
            margin: 0 0 0.5rem 0;
            color: var(--primary);
        }

        .side-blog p {
            margin: 0;
            font-size: 0.9rem;
        }

        .side-blog .meta {
            font-size: 0.8rem;
            margin-top: 0.5rem;
            color: var(--gray-900);
        }

        /* Week Trending Section */
        .trending {
            margin: 3rem auto 0 auto;
            max-width: 1200px;
        }

        .trending h2 {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .trending ul {
            list-style: none;
            padding: 0;
        }

        .trending li {
            padding: 0.8rem;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            justify-content: space-between;
        }

        .trending a {
            color: var(--gray-900);
            font-weight: 500;
        }

        .trending li span {
            color: var(--gray-800);
        }

       
    </style>
</head>
