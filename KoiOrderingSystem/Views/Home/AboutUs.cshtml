<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Pond with Fish Hole</title>
    <!-- FontAwesome Link -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <style>
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Roboto', sans-serif;
        }

        body {
            margin-top: 80px !important;
            background-color: white;
            color: #333;
            padding: 20px;
        }

        
        .container {
            width: 100%;
            max-width: 1200px;
            position: relative;
            margin: auto;
        }

        .pond {
            width: 100%;
            height: 500px;
            background: linear-gradient(180deg, #00a5ff 0%, #006994 50%, #004166 100%);
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(0, 165, 255, 0.3);
            border: 4px solid #004166;
        }
        
        .water-surface {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 30px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, transparent 100%);
        }

        .fas.fa-fish {
            position: absolute;
            font-size: 40px;
            color: #ffb300;
            filter: drop-shadow(0 0 5px rgba(255, 143, 0, 0.3));
            transition: transform 1s ease-in-out;
            cursor: grab;
            z-index: 1;
        }

        .bubble {
            position: absolute;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.2));
            border-radius: 50%;
            animation: rise 8s ease-in forwards;
            backdrop-filter: blur(1px);
            z-index: 1;
        }

        .fish-hole {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 62px;
            height: 65px;
            background: radial-gradient(circle at 30% 30%, #0e0e0e, #3a3a3a);
            border: 4px solid #5b5b5b;
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
            z-index: 10;
        }

        .spawn-fish-icon {
            position: absolute;
            top: 20px;
            left: 20px;
            width: 60px;
            height: 60px;
            background-color: #ffcc00;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 30px;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            z-index: 10;
            transition: background-color 0.3s;
        }

        .spawn-fish-icon:hover {
            background-color: #ff9933;
        }

        .welcome-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3rem;
            font-family: 'Arial', sans-serif;
            background: linear-gradient(45deg, #ff6ec4, #ffcc00, #4facfe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 300% 300%;
            animation: gradientMove 5s ease infinite, textGlow 2s ease-in-out infinite alternate, bounce 3s ease-in-out infinite;
            z-index: 2;
            white-space: nowrap; 
        }

        @@keyframes gradientMove {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes textGlow {
            0% {
                text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 20px rgba(255, 255, 255, 0.5), 0 0 30px rgba(255, 255, 255, 0.3);
            }
            100% {
                text-shadow: 0 0 20px rgba(255, 255, 255, 1), 0 0 40px rgba(255, 255, 255, 0.7), 0 0 60px rgba(255, 255, 255, 0.5);
            }
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translate(-50%, -50%) scale(1);
            }
            50% {
                transform: translate(-50%, -50%) scale(1.1);
            }
        }

        
        .custom-container {
            display: flex;
            width: 100%;
            max-width: 1000px;
            margin: 40px auto;
            background-color: #f9f9f9;
            border-radius: 12px;
            padding: 40px;
            justify-content: space-between;
            align-items: stretch;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: box-shadow 0.3s ease;
        }

        .custom-container:hover {
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .custom-box {
            flex: 1;
            padding-right: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .custom-box h2 {
            font-size: 1.8rem;
            color: #1d1d1f;
            margin-bottom: 10px;
        }

        .custom-box p {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .custom-toggle {
            width: 40px;
            height: 40px;
            cursor: pointer;
            font-size: 1.5rem;
            font-weight: bold;
            background: #007bff;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background-color 0.3s ease;
        }

        .custom-toggle.active {
            background: #0056b3;
        }

        .custom-right-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 12px;
            overflow: hidden;
            background-color: #f9f9f9;
            position: relative;
            transition: box-shadow 0.5s, transform 0.5s;
        }

        .custom-right-box .custom-image {
            width: 100%;
            height: 100%;
            max-height: 350px;
            background-color: #ddd;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s, box-shadow 0.5s;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            animation: fadeInScale 0.8s ease-in-out;
        }

        .custom-right-box .custom-content {
            display: none;
            font-size: 1.2rem;
            padding: 20px;
            text-align: justify;
        }

        .custom-right-box.show-content .custom-content {
            display: block;
            animation: fadeIn 0.5s ease-in;
        }

        .custom-right-box.hide-image .custom-image {
            display: none;
        }

        .custom-right-box.show-content .custom-image {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
        }

        .custom-container>div {
            min-height: 350px;
        }

        @@keyframes fadeInScale {
            0% {
                opacity: 0;
                transform: scale(0.8);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }
        .rock {
    position: absolute;
    bottom: 0;
    background: linear-gradient(45deg, #4a4a4a, #666);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    box-shadow: -2px -2px 5px rgba(0, 0, 0, 0.2);
    z-index: 1;
}


    .seaweed {
        position: absolute;
        bottom: 0;
        width: 20px;
        background: linear-gradient(to right, #2d5a27, #3a7a34);
        border-radius: 50% 50% 0 0;
        transform-origin: bottom center;
        animation: sway 6s ease-in-out infinite;
        filter: drop-shadow(0 0 5px rgba(45, 90, 39, 0.3));
        z-index: 1;
    }

    
    @@keyframes sway {
        0%, 100% {
            transform: rotate(0deg);
        }
        50% {
            transform: rotate(15deg);
        }
    }
    </style>
</head>

<body>
    <!-- 1234 -->
    <div class="container">
        <div class="pond" id="pond">
            <div class="water-surface"></div>
            <div class="sand"></div> <!-- Cát đã được thêm lại -->
            <div class="welcome-text">Welcome To Koi88</div> <!-- Text với hiệu ứng động -->
            <div class="fish-hole" id="fishHole"></div> <!-- Cái hố để thả cá -->
            <div class="spawn-fish-icon" id="spawnFishBtn">
                <i class="fas fa-fish"></i> <!-- Icon thêm cá -->
            </div>
        </div>
    </div>

    <!-- About Us Section -->
    <div class="custom-container">
        <div class="custom-box">
            <!-- About Us content -->
            <h2>About Us</h2>
            <p>
                We ensure that every transaction is carried out with complete honesty and transparency. Trust is the
                foundation of our business.
            </p>
            <div class="custom-toggle" onclick="toggleContent(this)">+</div>
        </div>
        <div class="custom-right-box" id="about-rightBox">
            <div class="custom-image" style="background-image: url(/images/Farm/farm1.jpg);"></div>
            <div class="custom-content">
                From humble beginnings, Koi88 has grown into a premier destination for Koi fish enthusiasts. We believe in building
                lasting relationships with our customers and offering support for all aspects of Koi care. Join us to discover the
                peace and joy that Koi fish bring to life.
            </div>
        </div>
    </div>

    <!-- Services Section -->
    <div class="custom-container">
        <div class="custom-box">
            <!-- About service -->
            <h2>Our Services</h2>
            <p>
                We offer a variety of services to ensure your satisfaction, from personalized trips to Koi farms to safe
                and reliable Koi delivery. Experience the best with us.
            </p>
            <div class="custom-toggle" onclick="toggleContent(this)">+</div>
        </div>
        <div class="custom-right-box" id="services-rightBox">
            <div class="custom-image" style="background-image: url(/images/Farm/farm2.jpg);"></div>
            <div class="custom-content">
                Our services extend beyond simple sales. We offer personalized consultations on pond maintenance, including tips on filtration, water quality, and seasonal care to ensure a thriving environment for your Koi. Additionally, we provide nutrition guidance to promote optimal Koi health, enhancing their color and vitality. For those looking to create the perfect Koi pond, our experts offer insights on design, ideal pond depth, and plant selection to achieve a balanced, serene aquatic setting. At every step, Koi88 is here to support and guide you, helping you build and maintain a beautiful, healthy pond.
            </div>
        </div>
    </div>

    <script>

        const pond = document.getElementById('pond');
        const fishHole = document.getElementById('fishHole');
        let fishCount = 6;
        let bubbleInterval;
        let draggedFish = null;
        let offsetX = 0;
        let offsetY = 0;

        function createFish(left = Math.random() * 80 + '%', top = Math.random() * 60 + 20 + '%') {
            const fish = document.createElement('i');
            fish.className = 'fas fa-fish';
            fish.style.left = left;
            fish.style.top = top;
            fish.style.fontSize = `${Math.random() * 20 + 30}px`;

            let targetX = Math.random() * 80;
            let targetY = Math.random() * 60 + 20;
            let currentX = parseFloat(fish.style.left);
            let currentY = parseFloat(fish.style.top);

            function swim() {
                if (!draggedFish || draggedFish !== fish) {  // Chỉ dừng cá bị kéo
                    if (Math.abs(targetX - currentX) < 1 && Math.abs(targetY - currentY) < 1) {
                        targetX = Math.random() * 80;
                        targetY = Math.random() * 60 + 20;
                    }

                    currentX += (targetX - currentX) * 0.003;
                    currentY += (targetY - currentY) * 0.003;

                    fish.style.left = currentX + '%';
                    fish.style.top = currentY + '%';

                    const angle = Math.atan2(targetY - currentY, targetX - currentX) * (180 / Math.PI);
                    fish.style.transform = `rotate(${angle}deg)`;
                }
                requestAnimationFrame(swim);
            }

            // Bắt đầu bắt cá
            fish.addEventListener('mousedown', (e) => {
                draggedFish = fish;
                const fishRect = fish.getBoundingClientRect();
                const pondRect = pond.getBoundingClientRect();
                offsetX = e.clientX - fishRect.left;
                offsetY = e.clientY - fishRect.top;
                fish.style.cursor = 'grabbing';
                fish.style.transition = 'none';  // Tắt animation khi kéo
            });

            // Di chuyển cá
            document.addEventListener('mousemove', (e) => {
                if (draggedFish) {
                    const pondRect = pond.getBoundingClientRect();
                    let x = e.clientX - pondRect.left - offsetX;
                    let y = e.clientY - pondRect.top - offsetY;

                    // Đảm bảo rằng cá không bị kéo ra ngoài hồ
                    x = Math.max(0, Math.min(x, pondRect.width - draggedFish.offsetWidth));
                    y = Math.max(0, Math.min(y, pondRect.height - draggedFish.offsetHeight));

                    draggedFish.style.left = x + 'px';  // Cập nhật bằng pixel
                    draggedFish.style.top = y + 'px';  // Cập nhật bằng pixel
                }
            });

            // Thả cá
            document.addEventListener('mouseup', () => {
                if (draggedFish) {
                    const fishRect = draggedFish.getBoundingClientRect();
                    const fishHoleRect = fishHole.getBoundingClientRect();

                    // Kiểm tra xem cá có được thả vào lỗ hay không
                    if (
                        fishRect.left < fishHoleRect.right &&
                        fishRect.right > fishHoleRect.left &&
                        fishRect.top < fishHoleRect.bottom &&
                        fishRect.bottom > fishHoleRect.top
                    ) {
                        draggedFish.remove();  // Cá biến mất nếu thả vào lỗ
                    } else {
                        const pondRect = pond.getBoundingClientRect();
                        const x = parseFloat(draggedFish.style.left);
                        const y = parseFloat(draggedFish.style.top);

                        // Chuyển đổi tọa độ pixel thành % để giữ vị trí khi thả
                        draggedFish.style.left = (x / pondRect.width) * 100 + '%';
                        draggedFish.style.top = (y / pondRect.height) * 100 + '%';
                    }

                    draggedFish.style.cursor = 'grab';
                    draggedFish.style.transition = 'transform 1s ease-in-out';  // Khôi phục animation sau khi thả
                    draggedFish = null;
                }
            });

            pond.appendChild(fish);
            swim();
        }

        // Tạo các con cá ban đầu
        for (let i = 0; i < fishCount; i++) {
            createFish();
        }

        // Tạo thêm cá khi nhấn nút
        const spawnFishBtn = document.getElementById('spawnFishBtn');
        spawnFishBtn.addEventListener('click', () => {
            for (let i = 0; i < 3; i++) {  // Tạo thêm 3 con cá mỗi lần nhấn
                createFish();
            }
        });

        // Tạo bột nước ngẫu nhiên và giới hạn số lượng bột
        function createBubble() {
            if (document.querySelectorAll('.bubble').length < 8) {
                const bubble = document.createElement('div');
                bubble.className = 'bubble';
                bubble.style.left = Math.random() * 100 + '%';
                const size = Math.random() * 12 + 5;
                bubble.style.width = size + 'px';
                bubble.style.height = size + 'px';
                bubble.style.animationDuration = (Math.random() * 4 + 5) + 's';
                pond.appendChild(bubble);

                bubble.addEventListener('animationend', () => bubble.remove());
            }
        }

        bubbleInterval = setInterval(createBubble, 2000);

        // Tạo đá
        for (let i = 0; i < 6; i++) {
            const rock = document.createElement('div');
            rock.className = 'rock';
            rock.style.left = (i * 20 + Math.random() * 10) + '%';
            rock.style.width = Math.random() * 40 + 30 + 'px';
            rock.style.height = Math.random() * 30 + 20 + 'px';
            rock.style.transform = `rotate(${Math.random() * 360}deg)`;
            pond.appendChild(rock);
        }

        // Tạo rêu
        for (let i = 0; i < 9; i++) {
            const seaweed = document.createElement('div');
            seaweed.className = 'seaweed';
            seaweed.style.left = (i * 14 + Math.random() * 5) + '%';
            seaweed.style.height = Math.random() * 90 + 60 + 'px';
            seaweed.style.animationDelay = Math.random() * 2 + 's';
            pond.appendChild(seaweed);
        }

        // Giải phóng tài nguyên khi tab bị ẩn hoặc không hoạt động
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                clearInterval(bubbleInterval);
            } else {
                bubbleInterval = setInterval(createBubble, 2000);
            }
        });

        function toggleContent(element) {
            const container = element.closest('.custom-container');
            const rightBox = container.querySelector('.custom-right-box');
            const isShowingContent = rightBox.classList.contains('show-content');

            // Toggle animation
            if (isShowingContent) {
                rightBox.classList.remove('show-content');
                rightBox.classList.remove('hide-image');
                element.classList.remove('active');
                element.textContent = '+';
            } else {
                rightBox.classList.add('show-content');
                rightBox.classList.add('hide-image');
                element.classList.add('active');
                element.textContent = '-';
            }
        }
    </script>

</body>

</html>
