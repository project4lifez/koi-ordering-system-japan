<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Imperial Koi | Premium Japanese Koi Farm</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.5/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/css/layout.css">

    <style>
        /* Dropdown Styles */
        .navigation-item.dropdown-menu-item {
            position: relative;
        }

        /* Styling for the dropdown button "Hi Trung" */
        .dropdown-toggle-link {
            margin-top: -8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--white); /* Matches the navbar text color */
            cursor: pointer;
        }

        /* Modern dropdown menu styling */
        .dropdown-options {
            position: absolute;
            top: 100%;
            left: 50%; /* Aligns dropdown menu center to the trigger */
            transform: translateX(-50%); /* Centers dropdown under "Hi Trung" */
            background: rgba(15, 23, 42, 0.95); /* Semi-transparent dark background */
            color: var(--gray-50);
            border-radius: 8px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); /* Soft shadow for depth */
            min-width: 200px;
            overflow: hidden;
            z-index: 1000;
            opacity: 0;
            transform: translate(-50%, -10px); /* Centers and adds slight upward offset */
            transition: opacity 0.3s ease, transform 0.3s ease; /* Smooth slide-down effect */
            display: none; /* Initially hidden */
        }

            .dropdown-options.show {
                display: block; /* Shows the dropdown */
                opacity: 1;
                transform: translate(-50%, 0); /* Moves into position */
            }

        /* Styling for individual dropdown items */
        .dropdown-option {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: var(--gray-50); /* Light text for contrast */
            font-weight: 500;
            text-decoration: none;
            transition: background 0.3s ease, color 0.3s ease;
        }

            .dropdown-option:hover {
                background: var(--primary-dark); /* Background color on hover */
                color: var(--accent-gold); /* Text color on hover */
                cursor: pointer;
            }

            /* Icon styling within the dropdown items */
            .dropdown-option i {
                font-size: 1.2rem; /* Icon size */
                color: var(--accent-gold); /* Accent color for icons */
            }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="nav-container">
            <a href="/" class="logo">
                <div>
                    <div class="logo-text">Koi88</div>
                    <div class="logo-japanese">帝国錦鯉</div>
                </div>
            </a>

            <nav>
                <ul class="navigation-menu">
                    <li><a href="/" class="navigation-link">Home</a></li>
                    <li><a href="#service" class="navigation-link">Service</a></li>
                    <li><a href="/Farm/Farm" class="navigation-link">Farm</a></li>
                    <li><a href="/Variety/Variety" class="navigation-link">Variety</a></li>
                    <li><a href="/Home/Blog" class="navigation-link">Blog</a></li>

                    <!-- Kiểm tra trạng thái đăng nhập của người dùng -->
                    @if (Context.Session.GetString("CustomerSession") != null && Context.Session.GetInt32("CustomerRoleId") == 1)
                    {
                        var lastname = Context.Session.GetString("CustomerLastName");
                        var username = Context.Session.GetString("CustomerSession");
                        var customerId = Context.Session.GetInt32("CustomerId");

                        <!-- Menu Dropdown cho người dùng đã đăng nhập -->
                        <li class="navigation-item dropdown-menu-item">
                            <a href="#" class="navigation-link dropdown-toggle-link" id="userDropdown">
                                <i class="fas fa-caret-down"></i> Hi @(string.IsNullOrEmpty(lastname) ? username : lastname)
                            </a>
                            <div class="dropdown-options">
                                <a class="dropdown-option" href="/Profile/CustomerProfile"><i class="fas fa-user-circle"></i> View Profile</a>
                                <a class="dropdown-option" href="/YourBooking"><i class="fas fa-calendar-check"></i> Your Order</a>
                                <a class="dropdown-option" href="/Login/Logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                            </div>
                        </li>
                    }
                    else
                    {
                        <!-- Menu Login/Signup cho người dùng chưa đăng nhập -->
                        <li><a href="/Login" class="navigation-link">Login/SignUp</a></li>
                    }
                </ul>
            </nav>



            <div class="nav-buttons">
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="language-toggle">
                    EN <i class="fas fa-globe"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-header">
            <div class="logo-text">Koi88</div>
            <button class="mobile-menu-close" id="mobileMenuClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <ul class="mobile-menu-nav">
            <li><a href="#home" class="mobile-menu-link">Home</a></li>
            <li><a href="#service" class="mobile-menu-link">Service</a></li>
            <li><a href="#farm" class="mobile-menu-link">Farm</a></li>
            <li><a href="#varieties" class="mobile-menu-link">Variety</a></li>
            <li><a href="#blog" class="mobile-menu-link">Blog</a></li>
            <li><a href="/Login" class="mobile-menu-link">Login/SignUp</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h3 class="footer-title">Imperial Koi</h3>
                    <p>Premium Japanese Koi breeding and distribution center, dedicated to maintaining the highest standards of quality and care.</p>
                    <div class="footer-social">
                        <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

                <div class="footer-section">
                    <h3 class="footer-title">Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="#about">About Us</a></li>
                        <li><a href="#varieties">Koi Varieties</a></li>
                        <li><a href="#tour">Virtual Tour</a></li>
                        <li><a href="#booking">Book a Visit</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-title">Services</h3>
                    <ul class="footer-links">
                        <li><a href="#">Koi Selection</a></li>
                        <li><a href="#">Pond Design</a></li>
                        <li><a href="#">Health Consultation</a></li>
                        <li><a href="#">Shipping Services</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-title">Newsletter</h3>
                    <p>Subscribe to receive updates about new arrivals and special offers.</p>
                  
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2024 Imperial Koi. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>

        document.getElementById('userDropdown').addEventListener('click', (e) => {
            e.preventDefault();
            const dropdownOptions = e.currentTarget.nextElementSibling;
            dropdownOptions.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.navigation-item.dropdown-menu-item')) {
                document.querySelectorAll('.dropdown-options').forEach(menu => {
                    menu.classList.remove('show');
                });
            }
        });

        // Initialize AOS

        // Theme Toggle
        const themeToggle = document.getElementById('themeToggle');
        themeToggle.addEventListener('click', () => {
            document.body.classList.toggle('dark-theme');
            themeToggle.innerHTML = document.body.classList.contains('dark-theme') ?
                '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
        });

       

    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
