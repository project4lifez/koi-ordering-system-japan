@{
    ViewData["Title"] = "Create Blog";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.tiny.cloud/1/kw6x5fktq4eib9zz0o7c5byyhnbdy7674vr2wkm1v6cbvf3d/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

    <style>
        body {
            padding: 20px;
        }

        .form-container {
            width: 100%;
            margin: 0 auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .btn-next {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
            padding: 10px 20px;
            float: right;
        }

        #previewImage {
            margin-top: 10px;
            max-width: 300px;
            height: auto;
            display: none;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <form method="post" action="/Admin/Blog/CreateBlog" enctype="multipart/form-data" id="createBlogForm">
            <div class="form-group">
                <label for="BlogName" class="form-label">Blog Name:</label>
                <input type="text" class="form-control" id="BlogName" name="BlogName" required>
            </div>

            <div class="form-group">
                <label for="Heading" class="form-label">Heading:</label>
                <input type="text" class="form-control" id="Heading" name="Heading" required>
            </div>

            <div class="form-group">
                <label for="Link" class="form-label">Content:</label>
                <textarea class="form-control" id="Link" name="Link" required></textarea>
            </div>

            <div class="form-group">
                <label for="Position" class="form-label">Position:</label>
                <select class="form-select" id="Position" name="Position" required>
                    <option value="">Select Position</option>
                    <option value="0">0</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>

            <div class="form-group">
                <label for="Status" class="form-label">Status:</label>
                <select class="form-select" id="Status" name="Status" required>
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
            </div>

            <div class="form-group">
                <label for="Image" class="form-label">Upload Blog Image:</label>
                <input type="file" class="form-control" id="Image" name="Image" accept="image/*" required>
            </div>
            <img id="previewImage" src="" alt="Blog Image Preview">

            <button type="submit" class="btn btn-next">Create Blog</button>
        </form>
    </div>

    <script>
        $(document).ready(function () {
            // Initialize TinyMCE editor
            tinymce.init({
                selector: '#Link', // Selector for the textarea
                plugins: 'link image code',
                toolbar: 'undo redo | styleselect | bold italic | alignleft aligncenter alignright | link image | code',
                height: 300,
                setup: function (editor) {
                    editor.on('change', function () {
                        editor.save(); // Ensures the value is saved when typing
                    });
                }
            });

            // Image preview functionality
            document.getElementById('Image').addEventListener('change', function (event) {
                const previewImage = document.getElementById('previewImage');
                const file = event.target.files[0];
                const reader = new FileReader();

                reader.onload = function (e) {
                    previewImage.src = e.target.result;
                    previewImage.style.display = 'block';
                };

                if (file) {
                    reader.readAsDataURL(file);
                } else {
                    previewImage.src = '';
                    previewImage.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>
