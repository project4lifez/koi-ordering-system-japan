@{
    ViewData["Title"] = "Update Variety";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <h1 class="text-center">Update Variety</h1>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 20px;
        }

        .form-container {
            width: 100%;
            margin: 0 auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .btn-next {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
            padding: 10px 20px;
            float: right;
        }

            .btn-next:hover {
                background-color: #0056b3;
                border-color: #0056b3;
            }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .form-layout {
            display: flex;
        }

        .sidebar {
            width: 25%;
            padding-right: 15px;
            font-size: 18px;
            font-weight: bold;
        }

        .form-content {
            width: 75%;
        }

        #previewImage {
            margin-top: 10px;
            max-width: 300px;
            height: auto;
        }

        .topic-container {
            margin-top: 15px;
        }

        .btn-add, .btn-remove {
            font-size: 12px;
            margin-left: 10px;
            cursor: pointer;
            color: #007bff;
        }

        .btn-remove {
            color: #dc3545;
        }

        /* Spacing for topic blocks */
        .topic-block {
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f9f9f9;
        }

            .topic-block label {
                display: block;
                margin-bottom: 5px;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="form-layout">
            <div class="sidebar">
                <p class="general-info-label">Update Information</p>
            </div>

            <div class="form-content">
                <form method="post" id="formUpdate" action="/Admin/Manager/UpdateVariety/@Model.VarietyId" enctype="multipart/form-data" onsubmit="return validateForm()">
                    <input type="hidden" name="VarietyId" value="@Model.VarietyId" />
                    <div class="form-group">
                        <label for="varietyId" class="form-label">Variety ID</label>
                        <input type="text" class="form-control" id="varietyId" name="VarietyId" value="@Model.VarietyId" readonly>
                    </div>
                    <div class="form-group">
                        <label for="varietyName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="varietyName" name="VarietyName" value="@Model.VarietyName" placeholder="Enter variety name" required>
                    </div>
                    <div class="form-group">
                        <label for="varietyDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="varietyDescription" name="Description" rows="3" placeholder="Enter variety description" required>@Model.Description</textarea>
                    </div>
                    <div class="form-group">
                        <label for="varietyImage" class="form-label">Image URL</label>
                        <input type="file" class="form-control" id="varietyImage" name="ImageUrl" accept="image/*">
                        <img id="previewImage" src="@Model?.ImageUrl" alt="Image Preview" style="display:block; margin-top:10px; max-width:100px; height:auto;">
                    </div>

                    <!-- Main Topic and Sub Topic Section -->
                    <div class="form-group topic-container" id="topicContainer">
                        @if (Model.MainTopics != null && Model.SubTopics != null)
                        {
                            var mainTopics = Model.MainTopics.Split('|');
                            var subTopics = Model.SubTopics.Split('|');
                            for (int i = 0; i < mainTopics.Length; i++)
                            {
                                <div class="topic-block">
                                    <label class="form-label">Main Topic @(i + 1)</label>
                                    <input type="text" class="form-control mb-3" name="MainTopic[]" value="@mainTopics[i]" placeholder="Main Topic Content">
                                    <label class="form-label">Sub Topic for Main Topic @(i + 1)</label>
                                    <textarea class="form-control mb-2" name="SubTopic[]" placeholder="Sub Topic Content">@subTopics[i]</textarea>
                                    <span class="btn-remove" onclick="removeMainTopic(this)">- Remove Main Topic</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="topic-block">
                                <label class="form-label">Main Topic 1</label>
                                <input type="text" class="form-control mb-3" name="MainTopic[]" placeholder="Main Topic Content" value="Static Main Topic Content">
                                <label class="form-label">Sub Topic for Main Topic 1</label>
                                <textarea class="form-control mb-2" name="SubTopic[]" placeholder="Sub Topic Content">Static Sub Topic Content</textarea>
                                <span class="btn-remove" onclick="removeMainTopic(this)">- Remove Main Topic</span>
                            </div>
                        }
                    </div>
                    <span class="btn-add" onclick="addTopic()">+ Add Main Topic</span>
                    <button type="submit" class="btn btn-next">Update</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let topicCounter = @((Model.MainTopics?.Split('|').Length ?? 1));

        document.getElementById('varietyImage').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('previewImage');
                    img.src = e.target.result;
                    img.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        function validateForm() {
            alert("Update Variety Successfully!!!");
            return true;
        }

        function addTopic() {
            topicCounter++;
            const topicContainer = document.getElementById("topicContainer");

            const topicBlock = document.createElement("div");
            topicBlock.className = "topic-block";

            const mainLabel = document.createElement("label");
            mainLabel.className = "form-label";
            mainLabel.innerText = `Main Topic ${topicCounter}`;
            topicBlock.appendChild(mainLabel);

            const mainInput = document.createElement("input");
            mainInput.type = "text";
            mainInput.className = "form-control mb-3";
            mainInput.name = "MainTopic[]";
            mainInput.placeholder = "Main Topic Content";
            topicBlock.appendChild(mainInput);

            const subLabel = document.createElement("label");
            subLabel.className = "form-label";
            subLabel.innerText = `Sub Topic for Main Topic ${topicCounter}`;
            topicBlock.appendChild(subLabel);

            const subInput = document.createElement("textarea");
            subInput.className = "form-control mb-2";
            subInput.name = "SubTopic[]";
            subInput.placeholder = "Sub Topic Content";
            subInput.style.resize = "vertical";
            topicBlock.appendChild(subInput);

            const removeMainTopicBtn = document.createElement("span");
            removeMainTopicBtn.className = "btn-remove";
            removeMainTopicBtn.innerText = "- Remove Main Topic";
            removeMainTopicBtn.onclick = function () { removeMainTopic(removeMainTopicBtn); };
            topicBlock.appendChild(removeMainTopicBtn);

            topicContainer.appendChild(topicBlock);
        }

        function removeMainTopic(button) {
            button.parentElement.remove();
        }
    </script>
</body>
