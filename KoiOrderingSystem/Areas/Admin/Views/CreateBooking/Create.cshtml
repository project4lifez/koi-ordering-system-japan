@using KoiOrderingSystem.Models
@model BookingViewModel
@{
    ViewBag.Title = "Create Booking";
    var customers = ViewBag.Customers as IEnumerable<dynamic>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Booking Form</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 800px;
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #4a5568;
            font-size: 0.95em;
        }

        input, select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 16px;
            background-color: white;
        }

            input:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .customer-dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            width: 100%;
            background-color: white;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
        }

        .search-box {
            position: sticky;
            top: 0;
            padding: 12px 16px;
            width: 100%;
            border: none;
            border-bottom: 2px solid #e2e8f0;
            font-size: 16px;
            background: white;
            z-index: 2;
        }

            .search-box:focus {
                outline: none;
                border-bottom-color: #667eea;
            }

        .customer-list {
            max-height: 250px;
            overflow-y: auto;
        }

        .customer-item {
            padding: 12px 16px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f0f0f0;
        }

            .customer-item:last-child {
                border-bottom: none;
            }

            .customer-item:hover {
                background-color: #f7fafc;
            }

        .customer-name {
            font-weight: 500;
        }

        .customer-id {
            color: #718096;
            font-size: 0.9em;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 14px 28px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            button:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            }

        .error {
            color: #e53e3e;
            font-size: 14px;
            margin-top: 5px;
        }

        /* Custom scrollbar */
        .dropdown-content::-webkit-scrollbar {
            width: 8px;
        }

        .dropdown-content::-webkit-scrollbar-track {
            background: #f7fafc;
        }

        .dropdown-content::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 4px;
        }

            .dropdown-content::-webkit-scrollbar-thumb:hover {
                background: #a0aec0;
            }

        .back-link {
            display: flex;
            align-items: center;
            color: #667eea;
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 20px;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .back-link:hover {
                color: #764ba2;
            }

            .back-link i {
                margin-right: 8px;
    </style>
</head>
<body>
    <div class="container">
        <a href="/Admin/Home/OrderManagement" class="back-link">
            <i class="fas fa-arrow-left"></i> Back to Order Management
        </a>
    <div class="container">
        <form action="/Admin/CreateBooking/Create" method="post" id="bookingForm">
            <div class="form-group">
                <label for="CustomerId">Customer</label>
                <div class="customer-dropdown">
                    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
                    <input type="text" id="customerSelect" readonly placeholder="Select Customer..." />
                    <div id="customerDropdown" class="dropdown-content">
                        <input type="text" class="search-box" id="customerSearch" placeholder="Search by name or ID..." />
                        <div id="customerList" class="customer-list">
                            <!-- Customer list will be populated dynamically by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input asp-for="Phone" type="tel" id="phone" class="form-control" required />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input asp-for="Email" type="email" id="email" class="form-control" required />
            </div>

            <div class="form-group">
                <label for="StartDate">Start Date</label>
                <input asp-for="StartDate" type="date" id="startDate" class="form-control" required />
            </div>

            <div class="form-group">
                <label for="EndDate">End Date</label>
                <input asp-for="EndDate" type="date" id="endDate" class="form-control" required />
                <div id="dateError" class="error"></div>
            </div>

            <button type="submit" class="btn btn-primary">Confirm Booking</button>
        </form>
    </div>

    <script>
        let customers = [];

        // Fetch customers from backend
        async function fetchCustomers() {
            try {
                const response = await fetch('/Admin/CreateBooking/GetCustomers'); // Ensure the endpoint is correct
                customers = await response.json();
                console.log(customers); // Debugging to ensure data is loaded
            } catch (error) {
                console.error('Error fetching customers:', error);
            }
        }

        // Populate customer list dynamically
        function renderCustomerList(customerArray) {
            const customerList = document.getElementById('customerList');
            customerList.innerHTML = customerArray.map(customer => `
                <div class="customer-item" data-id="${customer.customerId}">
                    <span class="customer-name">${customer.fullName}</span>
                    <span class="customer-id">${customer.customerId}</span>
                </div>
            `).join('');

            document.querySelectorAll('.customer-item').forEach(item => {
                item.addEventListener('click', () => {
                    const selectedCustomer = customers.find(c => c.customerId === parseInt(item.dataset.id));
                    if (!selectedCustomer) {
                        alert("Customer not found!");
                        return;
                    }

                    document.getElementById('customerSelect').value = `${selectedCustomer.fullName} (${selectedCustomer.customerId})`;
                    document.getElementById('CustomerId').value = selectedCustomer.customerId;
                    document.getElementById('phone').value = selectedCustomer.phone || ''; // Handle null phone
                    document.getElementById('email').value = selectedCustomer.email || ''; // Handle null email
                    document.getElementById('customerDropdown').style.display = 'none';
                });
            });
        }

        // Event listeners
        document.getElementById('customerSelect').addEventListener('click', async (e) => {
            e.stopPropagation();
            document.getElementById('customerDropdown').style.display = 'block';
            if (customers.length === 0) {
                await fetchCustomers();
            }
            renderCustomerList(customers);
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.customer-dropdown')) {
                document.getElementById('customerDropdown').style.display = 'none';
            }
        });

        document.getElementById('customerSearch').addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            const filteredCustomers = customers.filter(customer =>
                customer.fullName.toLowerCase().includes(searchTerm) ||
                customer.customerId.toString().toLowerCase().includes(searchTerm) // Ensure customerId is string
            );
            renderCustomerList(filteredCustomers);
        });

        // Validate dates
        function validateDates() {
            const startDate = new Date(document.getElementById('startDate').value);
            const endDate = new Date(document.getElementById('endDate').value);
            const dateError = document.getElementById('dateError');

            if (endDate < startDate) {
                dateError.textContent = 'End date must be later than start date.';
                return false;
            }
            dateError.textContent = '';
            return true;
        }

        document.getElementById('startDate').addEventListener('change', validateDates);
        document.getElementById('endDate').addEventListener('change', validateDates);

        // Handle form submission
        document.getElementById('bookingForm').addEventListener('submit', (e) => {
            if (!validateDates()) {
                e.preventDefault();
            }
        });

    </script>

</body>
</html>