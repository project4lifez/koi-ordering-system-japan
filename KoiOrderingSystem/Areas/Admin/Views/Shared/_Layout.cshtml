@{
    Layout = null;
    var adminRoleId = Context.Session.GetInt32("AdminRoleId");
    var adminLastName = Context.Session.GetString("AdminLastname");
    string pageTitle = "Dashboard";

    switch (adminRoleId)
    {
        case 2:
            pageTitle = "Dashboard - Manager";
            break;
        case 3:
            pageTitle = "Dashboard - SaleStaff";
            break;
        case 4:
            pageTitle = "Dashboard - Consulting";
            break;
        case 5:
            pageTitle = "Dashboard - Delivering";
            break;
        default:
            pageTitle = "Dashboard - Admin";
            break;
    }
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Admin Dashboard" />
    <meta name="author" content="Koi88" />
    <title>@pageTitle</title>
X    <link href="/Assets/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
        .notification-dropdown {
            width: 380px;
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 0;
            max-height: 480px;
            overflow-y: auto;
        }

        .notification-header {
            padding: 16px 20px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .notification-header h6 {
                font-weight: 600;
                margin: 0;
                color: #2c3e50;
                font-size: 1.1rem;
            }

        .notification-count {
            background: #e74c3c;
            color: white;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
        }

        .notification-item {
            padding: 16px 20px;
            border-bottom: 1px solid #f5f5f5;
            transition: background-color 0.2s;
            cursor: pointer;
        }

            .notification-item:hover {
                background-color: #f8f9fa;
            }

            .notification-item:last-child {
                border-bottom: none;
            }

        .notification-content {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .notification-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e3f2fd;
            color: #2196f3;
            flex-shrink: 0;
        }

        .notification-text {
            flex-grow: 1;
        }

        .notification-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 4px;
            font-size: 0.95rem;
        }

        .notification-message {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .notification-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: #95a5a6;
        }

        .notification-timestamp {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .notification-status {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 8px;
        }

        .status-unread {
            background: #3498db;
        }

        .notification-footer {
            padding: 12px;
            text-align: center;
            border-top: 1px solid #eee;
        }

        .view-all-link {
            color: #2196f3;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            display: block;
            padding: 8px;
            transition: color 0.2s;
        }

            .view-all-link:hover {
                color: #1976d2;
                text-decoration: none;
            }

        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(25%, -25%);
            background: #e74c3c;
            color: white;
            border-radius: 50%;
            padding: 0.15rem 0.3rem; /* Giảm padding */
            font-size: 0.65rem; /* Giảm kích thước font */
            min-width: 1.2rem; /* Giảm chiều rộng tối thiểu */
            text-align: center;
        }
    </style>
</head>
<body class="sb-nav-fixed">
    <!-- Top Navigation Bar -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark" style="background-color: #343a40 !important;">
        <a class="navbar-brand ps-3" href="@Url.Action("Index", "Dashboard")" style="background-color: #343a40 !important;">Koi88 Staff Dashboard</a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle"><i class="fas fa-bars"></i></button>
        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Search for..." aria-label="Search" aria-describedby="btnNavbarSearch" />
                <button class="btn btn-primary" id="btnNavbarSearch" type="button"><i class="fas fa-search"></i></button>
            </div>
        </form>
        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            <!-- Notification Bell Icon with Dropdown -->
            <li class="nav-item dropdown position-relative">
                <a class="nav-link" id="notificationDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="margin-top: 5px!important;">
                    <i class="fas fa-bell fa-fw"></i>
                    <span class="notification-badge">3</span>
                </a>
                <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
                    <div class="notification-header">
                        <h6>Notifications</h6>
                        <span class="notification-count">3 new</span>
                    </div>

                    <!-- New Booking Notification -->
                    <div class="notification-item">
                        <div class="notification-content">
                            <div class="notification-icon">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                            <div class="notification-text">
                                <div class="notification-title">New Booking #12345</div>
                                <div class="notification-message">
                                    A new booking has been placed by John Doe
                                </div>
                                <div class="notification-meta">
                                    <div class="notification-timestamp">
                                        <i class="far fa-clock"></i>
                                        <span>2 minutes ago</span>
                                    </div>
                                    <div class="notification-status status-unread"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Success Notification -->
                    <div class="notification-item">
                        <div class="notification-content">
                            <div class="notification-icon" style="background: #e8f5e9; color: #4caf50;">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="notification-text">
                                <div class="notification-title">Payment Successful</div>
                                <div class="notification-message">
                                    Payment for Booking #12344 has been confirmed
                                </div>
                                <div class="notification-meta">
                                    <div class="notification-timestamp">
                                        <i class="far fa-clock"></i>
                                        <span>15 minutes ago</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- System Update Notification -->
                    <div class="notification-item">
                        <div class="notification-content">
                            <div class="notification-icon" style="background: #fff3e0; color: #ff9800;">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <div class="notification-text">
                                <div class="notification-title">System Update</div>
                                <div class="notification-message">
                                    System maintenance scheduled for tonight
                                </div>
                                <div class="notification-meta">
                                    <div class="notification-timestamp">
                                        <i class="far fa-clock"></i>
                                        <span>1 hour ago</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="notification-footer">
                        <a href="#" class="view-all-link">View All Notifications</a>
                    </div>
                </div>
            </li>

            <!-- User Profile Dropdown -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="userDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user fa-fw"></i>
                    @if (!string.IsNullOrEmpty(adminLastName))
                    {
                        <span>@adminLastName</span>
                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/Admin/Profile">Profile</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("ActivityLog", "Account")">Activity Log</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Login")">Logout</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav" style="background-color: #000000 !important;">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu" style="background-color: #343a40 !important;">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Core</div>
                        @if (adminRoleId >= 2 && adminRoleId <= 5)
                        {
                            <a class="nav-link" href="@Url.Action("Home", "Admin")">
                                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                                Dashboard
                            </a>
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseOrders" aria-expanded="false" aria-controls="collapseOrders">
                                <div class="sb-nav-link-icon"><i class="fas fa-shopping-cart"></i></div>
                                Orders
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>
                            <div class="collapse" id="collapseOrders" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    <a class="nav-link" href="/Admin/Home/OrderList">Order List</a>
                                    <a class="nav-link" href="/Admin/Home/OrderManagement">Order Management</a>
                                </nav>
                            </div>
                        }
                        @if (adminRoleId == 2)
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseProduct" aria-expanded="false" aria-controls="collapseProduct">
                                <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                                Categories
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>
                            <div class="collapse" id="collapseProduct" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    <a class="nav-link" href="/Admin/Manager/KoiFarmList">Koi Farm List</a>
                                    <a class="nav-link" href="/Admin/Manager/KoiVarietyList">Variety List</a>
                                    <a class="nav-link" href="/Admin/Manager/KoiFishList">Koi Fish List</a>
                                </nav>
                            </div>

                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseAccount" aria-expanded="false" aria-controls="collapseProduct">
                                <div class="sb-nav-link-icon"><i class="fas fa-user"></i></div>
                                 Management
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>
                            <div class="collapse" id="collapseAccount" aria-labelledby="headingThree" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    <a class="nav-link" href="/Admin/StaffList">Employee Card</a>
                                    <a class="nav-link" href="/Admin/UserList">User Information</a>
                                    <a class="nav-link" href="/Admin/RoleList">Role List</a>
                                    <a class="nav-link" href="/Admin/PaymentMethod">Payment Method List</a>
                                    <a class="nav-link" href="/Admin/Blog/BlogList">Blog</a>


                                </nav>
                            </div>

                            
                            <a class="nav-link" href="/Admin/Manager/Feedback">
                                <div class="sb-nav-link-icon"><i class="fas fa-comments"></i></div>
                                Feedback
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main>
                @RenderBody()
            </main>

            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">SWP391_Group6 © 2024</div>
                        <div>
                            <a href="#">Privacy Policy</a> &middot; <a href="#">Terms &amp; Conditions</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/Assets/admin/js/scripts.js"></script>
</body>
</html>
