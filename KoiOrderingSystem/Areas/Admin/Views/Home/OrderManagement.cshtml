@model IEnumerable<KoiOrderingSystem.Models.Booking>

@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var adminRoleId = Context.Session.GetInt32("AdminRoleId");
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management</title>
    <style>
      :root {
            --primary-color: #4a90e2;
            --secondary-color: #f7e6a2;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --light-gray: #f8f9fa;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .container-fluid {
            padding: 2rem;
            animation: fadeIn 0.5s ease-in;
        }

        /* Header Styling */
        h1 {
            color: #2c3e50;
            font-weight: 600;
            text-align: center;
            margin-bottom: 2rem;
            position: relative;
            padding-bottom: 0.5rem;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: var(--primary-color);
            border-radius: 2px;
        }

        /* Search and Filter Section */
        .search-filter-section {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
            transform: translateY(0);
            transition: transform 0.3s ease;
        }

        .search-filter-section:hover {
            transform: translateY(-5px);
        }

        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(74, 144, 226, 0.25);
        }

        /* Table Styling */
        .table-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 1.5rem;
            overflow: hidden;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: var(--primary-color);
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem;
            border: none;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

        .table tbody tr:hover {
            background-color: rgba(74, 144, 226, 0.1);
            transform: scale(1.01);
        }

        /* Status Badges */
        .badge {
            margin-top: 6px;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            animation: fadeIn 0.5s ease;
        }

        .badge-pending {
            background: linear-gradient(45deg, #808080, #a9a9a9);
            color: white;
        }

        .badge-cancel {
            background: linear-gradient(45deg, #dc3545, #ff6b6b);
            color: white;
        }

        .badge-confirm {
            background: linear-gradient(45deg, #28a745, #5cb85c);
            color: white;
        }

        /* Buttons */
        .btn {
            border-radius: 50px;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: -100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: 0.5s;
        }

        .btn:hover::after {
            left: 100%;
        }

        /* Modal Styling */
        .modal-content {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .modal-header {
            background: var(--primary-color);
            color: white;
            border-radius: 15px 15px 0 0;
            padding: 1.5rem;
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            border-top: none;
            padding: 1.5rem;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes slideIn {
            from { transform: translateX(-100%); }
            to { transform: translateX(0); }
        }

        /* Pagination */
        .pagination {
            margin-top: 2rem;
        }

        .page-link {
            border-radius: 50%;
            margin: 0 5px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            color: var(--primary-color);
            transition: all 0.3s ease;
        }

        .page-link:hover {
            background: var(--primary-color);
            color: white;
            transform: scale(1.1);
        }

        .page-item.active .page-link {
            background: var(--primary-color);
            color: white;
            transform: scale(1.1);
        }

        /* Nền cho ô Po */
        .po-cell {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb); /* màu xanh nhạt để dễ nhận diện */
            padding: 0.75rem;
            border-radius: 10px;
            font-weight: 500;
            color: #1976d2; /* Màu chữ tương phản */
            transition: all 0.3s ease;
        }

            .po-cell:hover {
                background: #bbdefb; /* Tăng màu khi hover */
                transform: scale(1.02);
            }

        .badge-other {
            background: linear-gradient(45deg, #ffd54f, #ffb300); /* Gradient vàng nhạt đến vàng đậm */ 
            color: white;
        }
    </style>
</head>

<body>
    <main class="container-fluid px-4">
        <h1 class="mt-4">Order Management</h1>

        <!-- Search and Filter Section -->
        <form method="get" action="/Admin/Home/OrderManagement" class="row mb-4">
            <div class="col-md-4">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search by Booking ID or Trip Name" value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-4">
                <select name="statusFilter" class="form-select">
                    <option value="">Filter by Status</option>
                    @if (adminRoleId == 3)
                    {
                        <option value="Requested" @(ViewBag.StatusFilter == "Requested" ? "selected" : "")>Requested</option>
                        <option value="Processing" @(ViewBag.StatusFilter == "Processing" ? "selected" : "")>Processing</option>
                        <option value="Rejected" @(ViewBag.StatusFilter == "Rejected" ? "selected" : "")>Rejected</option>
                        <option value="Accepted" @(ViewBag.StatusFilter == "Accepted" ? "selected" : "")>Accepted</option>
                    }
                    else if (adminRoleId == 4)
                    {
                        <option value="Confirmed" @(ViewBag.StatusFilter == "Confirmed" ? "selected" : "")>Confirmed</option>
                        <option value="Checked in" @(ViewBag.StatusFilter == "Checked in" ? "selected" : "")>Checked in</option>
                        <option value="Checked out" @(ViewBag.StatusFilter == "Checked out" ? "selected" : "")>Checked out</option>
                    }
                    else if (adminRoleId == 5)
                    {
                        <option value="Checked out" @(ViewBag.StatusFilter == "Checked out" ? "selected" : "")>Checked out</option>
                        <option value="Delivering" @(ViewBag.StatusFilter == "Delivering" ? "selected" : "")>Delivering</option>
                        <option value="Delivered" @(ViewBag.StatusFilter == "Delivered" ? "selected" : "")>Delivered</option>
                        <option value="Failed" @(ViewBag.StatusFilter == "Failed" ? "selected" : "")>Failed</option>
                    }
                    @if (adminRoleId == 2)
                    {
                        <option value="Requested" @(ViewBag.StatusFilter == "Requested" ? "selected" : "")>Requested</option>
                        <option value="Processing" @(ViewBag.StatusFilter == "Processing" ? "selected" : "")>Processing</option>
                        <option value="Rejected" @(ViewBag.StatusFilter == "Rejected" ? "selected" : "")>Rejected</option>
                        <option value="Accepted" @(ViewBag.StatusFilter == "Accepted" ? "selected" : "")>Accepted</option>
                        <option value="Failed" @(ViewBag.StatusFilter == "Failed" ? "selected" : "")>Failed</option>
                        <option value="Refunding" @(ViewBag.StatusFilter == "Refunding" ? "selected" : "")>Refunding</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="orderTable">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Booking ID</th>
                        <th>Booking Date</th>
                        <th>Customer</th>
                        <th>Trip Name</th>
                        <th>Price</th>
                        <th>Status</th>
                        @if (adminRoleId == 3 || adminRoleId == 2)
                        {
                            <th>Booking Form</th>
                        }
                        @if (adminRoleId >= 2 && adminRoleId <= 5)
                        {
                            <th>Edit</th> <!-- Edit column for all roles -->
                            @if (adminRoleId == 2 || adminRoleId == 3)
                            {
                                <th>Quote</th> <!-- Detail column only for role 2 and 3 -->
                            }
                        }
                        @if (adminRoleId == 2 || adminRoleId == 4)
                        {
                            <th>Po</th>
                        }
                    </tr>
                </thead>

                @if (Model != null && Model.Any())
                {
                    // Calculate the starting index based on the current page and page size
                    int index = (ViewBag.Page1 - 1) * ViewBag.PageSize + 1;

                    <tbody>
                        @foreach (var booking in Model)
                        {
                            bool renderRow = false;

                            // Role 2: "Requested", "Processing", "Rejected", "Accepted", "Failed", "Refunding"
                            if (adminRoleId == 2 && (booking.Status == "Requested" || booking.Status == "Processing" || booking.Status == "Rejected" || booking.Status == "Accepted" || booking.Status == "Failed" || booking.Status == "Refunding"))
                            {
                                renderRow = true;
                            }

                            // Role 3: "Requested", "Processing", "Rejected", "Accepted"
                            if (adminRoleId == 3 && (booking.Status == "Requested" || booking.Status == "Processing" || booking.Status == "Rejected" || booking.Status == "Accepted"))
                            {
                                renderRow = true;
                            }

                            // Role 4: "Confirmed", "Checked in", "Checked out"
                            if (adminRoleId == 4 && (booking.Status == "Confirmed" || booking.Status == "Checked in" || booking.Status == "Checked out"))
                            {
                                renderRow = true;
                            }

                            // Role 5: "Checked out", "Delivering", "Failed"
                            if (adminRoleId == 5 && (booking.Status == "Checked out" || booking.Status == "Delivering" || booking.Status == "Failed"))
                            {
                                renderRow = true;
                            }

                            // Conditionally render the row based on the role and booking status
                            if (renderRow)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td class="booking-id">@booking.BookingId</td>
                                    <td>@booking.BookingDate</td>
                                    <td class="text-success">@booking.Fullname</td>
                                    <td class="trip-name">@(booking.Trip?.TripName ?? "No Trip Name")</td>
                                    <td>@booking.QuotedAmount</td>

                                    <!-- Render Status Column for All Roles -->
                                    <td class="booking-status">
                                        @* Conditional logic for status badge color *@
                                        @{
                                            string statusClass = booking.Status.ToLower() switch
                                            {
                                                "requested" => "badge-pending",
                                                "canceled" => "badge-cancel",
                                                "rejected" => "badge-cancel",
                                                "accepted" => "badge-confirm",
                                                "delivered" => "badge-confirm",
                                                "confirmed" => "badge-confirm",
                                                "failed" => "badge-cancel",
                                                _ => "badge-other"
                                            };
                                        }
                                        <span class="badge @statusClass">@booking.Status</span>
                                    </td>

                                    @if (adminRoleId == 3 || adminRoleId == 2)
                                    {
                                        <td>
                                            <a href="javascript:void(0);" class="btn btn-primary btn-sm"
                                               onclick="openFormModal('@booking.Fullname', '@booking.Phone', '@booking.Email',
                             '@booking.Gender', '@booking.Favoritefarm', '@booking.FavoriteKoi',
                             '@booking.StartDate', '@booking.EndDate',
                             '@booking.EstimatedCost', '@booking.HotelAccommodation',
                             '@booking.Note')">View Form</a>
                                        </td>
                                    }

                                    <!-- Edit logic for all roles (2, 3, 4, 5) -->
                                    <td>
                                        @if (adminRoleId == 2)
                                        {
                                            <a href="/Admin/Manager/Manager?id=@booking.BookingId" class="btn btn-warning btn-sm">Edit</a>
                                        }
                                        @if (adminRoleId == 3)
                                        {
                                            <a href="/Admin/Sale/Sale?id=@booking.BookingId" class="btn btn-warning btn-sm">Edit</a>
                                        }
                                        @if (adminRoleId == 4)
                                        {
                                            <a href="/Admin/Consulting/Consulting?Bookingid=@booking.BookingId" class="btn btn-warning btn-sm">Edit</a>
                                        }
                                        @if (adminRoleId == 5)
                                        {
                                            <a href="/Admin/Delivering/Delivering?id=@booking.BookingId" class="btn btn-warning btn-sm">Edit</a>
                                        }
                                    </td>

                                    @if (adminRoleId == 2 || adminRoleId == 3)
                                    {
                                        <!-- Quote logic for only role 2 and 3 -->
                                        <td>
                                            <a href="/Admin/Sale/Quote?bookingId=@booking.BookingId" class="btn btn-info btn-sm">Quote</a>
                                        </td>
                                    }
                                    @if (adminRoleId == 2 || adminRoleId == 4)
                                    {
                                        <td>
                                            <a href="/Admin/PoDetail/PoDetail?bookingId=@booking.BookingId" class="btn po-cell btn-yellow btn-sm">Po</a>
                                        </td>
                                    }

                                </tr>
                                index++; // Increment counter
                            }
                        }
                    </tbody>
                }
                else
                {
                    <p>No bookings available.</p>
                }

            </table>
        </div>

        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <!-- Nút Previous -->
                @if (ViewBag.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.Page - 1)&searchQuery=@ViewBag.SearchQuery&statusFilter=@ViewBag.StatusFilter" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                <!-- Hiển thị số trang -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&searchQuery=@ViewBag.SearchQuery&statusFilter=@ViewBag.StatusFilter">@i</a>
                    </li>
                }

                <!-- Nút Next -->
                @if (ViewBag.Page < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.Page + 1)&searchQuery=@ViewBag.SearchQuery&statusFilter=@ViewBag.StatusFilter" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Modal for Form -->
        <div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="formModalLabel">Customer Booking </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formFullName" class="form-label">Full Name</label>
                                    <input type="text" class="form-control" id="formFullName" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formPhone" class="form-label">Phone</label>
                                    <input type="text" class="form-control" id="formPhone" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formEmail" class="form-label">Email</label>
                                    <input type="text" class="form-control" id="formEmail" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formGender" class="form-label">Gender</label>
                                    <input type="text" class="form-control" id="formGender" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formFarm" class="form-label">The farm which want to come</label>
                                    <input type="text" class="form-control" id="formFarm" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formBreed" class="form-label">Koi breed which want to buy</label>
                                    <input type="text" class="form-control" id="formBreed" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formStartDate" class="form-label">Estimated departure date</label>
                                    <input type="text" class="form-control" id="formStartDate" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formEndDate" class="form-label">Return date</label>
                                    <input type="text" class="form-control" id="formEndDate" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formCost" class="form-label">Estimated cost</label>
                                    <input type="text" class="form-control" id="formCost" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="formHotel" class="form-label">Hotel accommodation</label>
                                    <input type="text" class="form-control" id="formHotel" readonly>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="formNote" class="form-label">Additional Information</label>
                            <textarea id="formNote" class="form-control" rows="4" readonly></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="printForm()">Print Form</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        function openFormModal(fullName, phone, email, gender, farm, breed, startDate, endDate, cost, hotel, note) {
            document.getElementById('formFullName').value = fullName || 'N/A';
            document.getElementById('formPhone').value = phone || 'N/A';
            document.getElementById('formEmail').value = email || 'N/A';
            document.getElementById('formGender').value = gender || 'N/A';
            document.getElementById('formFarm').value = farm || 'N/A';
            document.getElementById('formBreed').value = breed || 'N/A';
            document.getElementById('formStartDate').value = startDate || 'N/A';
            document.getElementById('formEndDate').value = endDate || 'N/A';
            document.getElementById('formCost').value = cost || 'N/A';
            document.getElementById('formHotel').value = hotel || 'N/A';
            document.getElementById('formNote').value = note || 'N/A';

            const formModal = new bootstrap.Modal(document.getElementById('formModal'));
            formModal.show();
        }

        // Enhanced JavaScript functionality
        $(document).ready(function() {
            // Animate elements on page load
            $('.table-container').addClass('animate__animated animate__fadeIn');
            $('.search-filter-section').addClass('animate__animated animate__slideInDown');

            // Add loading animation when clicking buttons
            $('.btn').click(function() {
                $(this).addClass('animate__animated animate__pulse');
                setTimeout(() => {
                    $(this).removeClass('animate__animated animate__pulse');
                }, 1000);
            });

            // Enhance table row hover effect
            $('.table tbody tr').hover(
                function() {
                    $(this).addClass('animate__animated animate__pulse');
                },
                function() {
                    $(this).removeClass('animate__animated animate__pulse');
                }
            );

            // Add smooth scrolling
            $('a[href^="#"]').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $($(this).attr('href')).offset().top
                }, 500, 'linear');
            });

            // Enhanced modal animations
            $('#formModal').on('show.bs.modal', function () {
                $(this).find('.modal-content')
                    .addClass('animate__animated animate__zoomIn');
            });

            $('#formModal').on('hide.bs.modal', function () {
                $(this).find('.modal-content')
                    .addClass('animate__animated animate__zoomOut');
            });

            // Enhanced status badge animations
            $('.badge').each(function() {
                $(this).hover(
                    function() {
                        $(this).addClass('animate__animated animate__pulse');
                    },
                    function() {
                        $(this).removeClass('animate__animated animate__pulse');
                    }
                );
            });

            // Add loading spinner
            function showLoading() {
                const spinner = `
                    <div class="loading-spinner">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                `;
                $('body').append(spinner);
            }

            function hideLoading() {
                $('.loading-spinner').remove();
            }

            // Enhanced form submission
            $('form').on('submit', function() {
                showLoading();
                setTimeout(hideLoading, 1000);
            });
        });

        // Enhanced print functionality
        function printForm() {
            const printWindow = window.open('', '', 'width=800,height=600');
            const content = document.getElementById('formModal').innerHTML;
            
            printWindow.document.write(`
                <html>
                    <head>
                        <title>Print Form</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; }
                            .form-group { margin-bottom: 15px; }
                            label { font-weight: bold; }
                            @@media print {
                                .no-print { display: none; }
                            }
                        </style>
                    </head>
                    <body>
                        ${content}
                    </body>
                </html>
            `);
            
            printWindow.document.close();
            setTimeout(() => {
                printWindow.print();
                printWindow.close();
            }, 500);
        }
    </script>
</body>
